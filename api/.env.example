# --- Aplicación ---
APP_NAME=Sistema Integrado HITSS
APP_ROOT_PATH=

# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=tecnoinsights_unificado

# --- Seguridad (JWT) ---
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_ALGORITMO=HS256
JWT_EXPIRA_MINUTOS=480

# --- CORS (frontend en desarrollo) ---
CORS_ORIGINS=http://localhost:5173

# --- Superadmin inicial (creado al primer arranque) ---
SUPERADMIN_NOMBRE=Administrador
SUPERADMIN_EMAIL=admin@hitss.com
SUPERADMIN_PASSWORD=Admin123*

# --- Aplicación inicial (datos migrados) ---
APLICACION_INICIAL_CODIGO=epm-hitss
APLICACION_INICIAL_NOMBRE=EPM-HITSS

# --- Integración externa (Power Automate) ---
# Cada endpoint de integración usa su propia API Key. Al agregar una nueva variable
# aquí, recuerda también definirla con un valor real en el .env local (este archivo
# es solo la plantilla; .env está en .gitignore y no se actualiza solo).
API_KEY=
API_KEY_REQUERIMIENTOS=
API_KEY_SOLICITUDES=

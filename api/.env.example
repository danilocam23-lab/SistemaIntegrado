# --- Aplicación ---
APP_NAME=Sistema Integrado HITSS
APP_ROOT_PATH=

# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=tecnoinsights_unificado

# --- Seguridad (JWT) ---
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_ALGORITMO=HS256
JWT_EXPIRA_MINUTOS=480

# --- Eventos de uso (auditoría de pantallas) ---
# Días de retención (TTL de Mongo; cambiarlo exige recrear el índice ix_evento_uso_ttl).
EVENTOS_USO_RETENCION_DIAS=400
EVENTOS_USO_LIMITE_POR_MINUTO=120
# Tamaño máximo del cuerpo de POST /auditoria/eventos-uso (bytes); si lo excede, 413.
EVENTOS_USO_MAX_BYTES=32768
# Cupo diario por usuario de interaction_id nuevos (fuera del catálogo conocido).
EVENTOS_USO_IDS_NUEVOS_POR_DIA=30
# Rango máximo (días) de GET /auditoria/resumen-uso; por defecto se consultan 90 días.
RESUMEN_USO_RANGO_MAX_DIAS=400
RESUMEN_USO_MAX_FILAS=5000

# --- Auditoría de login ---
# Retención (TTL, índice parcial ix_auditoria_login_ttl) de los registros de login, que
# contienen ip, user_agent y email_hmac. Cambiarla exige recrear el índice.
AUDITORIA_LOGIN_RETENCION_DIAS=180
# Clave propia del HMAC del email intentado. Si se deja vacía se usa JWT_SECRET (no
# recomendado: acopla ambos secretos). Cambiarla invalida las huellas ya guardadas.
AUDITORIA_HMAC_SECRET=
# true SOLO si la API está detrás de un proxy propio (IIS/ARR) que añade X-Forwarded-For:
# se usa el último valor de la cabecera. Con false se usa la IP del socket.
AUDITORIA_CONFIAR_PROXY=false

# --- CORS (frontend en desarrollo) ---
CORS_ORIGINS=http://localhost:5173

# --- Superadmin inicial (creado al primer arranque) ---
SUPERADMIN_NOMBRE=Administrador
SUPERADMIN_EMAIL=admin@hitss.com
SUPERADMIN_PASSWORD=Admin123*

# --- Aplicación inicial (datos migrados) ---
APLICACION_INICIAL_CODIGO=epm-hitss
APLICACION_INICIAL_NOMBRE=EPM-HITSS

# --- Integración externa (Power Automate) ---
# Cada endpoint de integración usa su propia API Key. Al agregar una nueva variable
# aquí, recuerda también definirla con un valor real en el .env local (este archivo
# es solo la plantilla; .env está en .gitignore y no se actualiza solo).
API_KEY=
API_KEY_REQUERIMIENTOS=
API_KEY_SOLICITUDES=
